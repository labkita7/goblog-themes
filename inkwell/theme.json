{
  "slug": "inkwell",
  "name": "Inkwell",
  "version": "1.0.0",
  "author": "labkita7",
  "description": "Ink-on-paper editorial with a deep blue accent.",
  "engines": {
    "goblog": ">=1.0.0 <2.0.0"
  },
  "screenshot": "screenshot.png",
  "settings": [
    {
      "key": "accent",
      "label": "Accent color",
      "type": "color",
      "default": "#1e3a8a"
    },
    {
      "key": "font_heading",
      "label": "Heading font",
      "type": "select",
      "options": [
        "Inter",
        "Georgia"
      ],
      "default": "Georgia"
    },
    {
      "key": "show_reading_time",
      "label": "Show reading time",
      "type": "bool",
      "default": true
    },
    {
      "key": "ink_style",
      "label": "Ink style",
      "type": "select",
      "options": [
        "sharp",
        "soft"
      ],
      "default": "sharp"
    }
  ]
}

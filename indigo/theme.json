{
  "slug": "indigo",
  "name": "Indigo",
  "version": "1.1.0",
  "author": "labkita7",
  "description": "Centered editorial layout with a hairline masthead rule, numbered entries and a drop cap in the reading column.",
  "engines": {
    "goblog": ">=1.0.0 <2.0.0"
  },
  "screenshot": "screenshot.png",
  "settings": [
    {
      "key": "accent",
      "label": "Accent color",
      "type": "color",
      "default": "#4338ca"
    },
    {
      "key": "font_heading",
      "label": "Heading font",
      "type": "select",
      "options": [
        "Inter",
        "Georgia"
      ],
      "default": "Georgia"
    },
    {
      "key": "show_reading_time",
      "label": "Show reading time",
      "type": "bool",
      "default": true
    },
    {
      "key": "show_numbers",
      "label": "Number the entries",
      "type": "bool",
      "default": true
    }
  ]
}
